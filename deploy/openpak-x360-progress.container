# PRIMARY host. OpenPak Xbox 360 progress REST service (x360-progress), hive root LiveServiceUrl.progress = https://progress.xboxlive.com.
# The console resolves progress.xboxlive.com through OpenPak's DNS to this host; Traefik routes Host(progress.xboxlive.com) on the
# TLS passthrough entrypoint to :10441; diagnostics use the plain-HTTP entrypoint to :10041. Verifies the tokens x360-xsts issues (its signing key, read-only).
[Unit]
Description=OpenPak Xbox 360 progress REST service (x360-progress)

[Container]
ContainerName=openpak-x360-progress
Image=ghcr.io/openpak/x360-progress:latest
AutoUpdate=registry
Network=openpak.network
# Pin an unused address (run pin-ips.sh --apply for new quadlets).
IP=10.89.2.238
Environment=X360_PROGRESS_ADDR=:10041
Environment=X360_PROGRESS_XSTS_KEY=/run/xsts/signing.key
Volume=%h/openpak/deploy/x360-xsts/state/signing.key:/run/xsts/signing.key:ro,Z
Environment=X360_SERVICE_TLS_ADDR=:10441
Environment=X360_SERVICE_TLS_CERT=/run/tls/server.pem
Environment=X360_SERVICE_TLS_KEY=/run/tls/server.key
# Leaf signed by the x360-xuacs CA, which /xsig validates. Never mount the CA key here.
Volume=%h/openpak/deploy/x360-progress/tls:/run/tls:ro,Z
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
UserNS=keep-id:uid=100,gid=101

[Service]
Restart=always

[Install]
WantedBy=default.target
